{
  "name": "@arkmp/cli",
  "version": "0.1.0",
  "description": "ArkMP 命令行入口（ark-mp）",
  "type": "module",
  "bin": {
    "ark-mp": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkmp/compiler": "workspace:*",
    "@arkmp/config": "workspace:*",
    "@arkmp/devtool": "workspace:*",
    "@arkmp/diagnostics": "workspace:*",
    "@arkmp/pipeline": "workspace:*",
    "@arkmp/runtime": "workspace:*",
    "@arkmp/shared": "workspace:*",
    "@arkmp/templates": "workspace:*",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
