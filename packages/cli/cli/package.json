{
  "name": "@arkmp/cli",
  "version": "0.1.0",
  "description": "ArkMP 命令行入口（ark-mp）",
  "type": "module",
  "bin": {
    "ark-mp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkmp/compiler": "workspace:*",
    "@arkmp/config": "workspace:*",
    "@arkmp/devtool": "workspace:*",
    "@arkmp/diagnostics": "workspace:*",
    "@arkmp/pipeline": "workspace:*",
    "@arkmp/runtime": "workspace:*",
    "@arkmp/templates": "workspace:*",
    "@arkmp/shared": "workspace:*",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "@types/node": "^24.13.3"
  }
}
