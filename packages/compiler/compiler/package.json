    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkmp/runtime": "^0.1.1",
    "chokidar": "^4.0.3",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@arkmp/dep-graph": "workspace:*",
    "@arkmp/diagnostics": "workspace:*",
    "@arkmp/incremental": "workspace:*",
    "@arkmp/ir": "workspace:*",
    "@arkmp/mapping-components": "workspace:*",
    "@arkmp/pipeline": "workspace:*",
    "@arkmp/shared": "workspace:*",
    "@arkmp/watcher": "workspace:*",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
