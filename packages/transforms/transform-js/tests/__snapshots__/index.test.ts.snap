exports[`与 transform-events 的合并协议 > eventMethods 经同一套改写后并入 methods 末尾 1`] = `
"// Generated by ArkMP, do not edit
const { createPage } = require('@arkmp/runtime');

createPage({
  state: {
    count: 0,
  },
  methods: {
    submit() {
      this.__set('count', 0);
    },
    __n7_click() {
      this.__set('count', this.count + 1);
      this.submit();
    },
  },
});
"
