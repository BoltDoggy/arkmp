// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`T23 @State → data + 赋值改写 > 基本页面：state 初始值 + 自增改写快照 1`] = `
"// Generated by ArkMP, do not edit
const { createPage } = require('@arkmp/runtime');

createPage({
  state: {
    count: 0,
    list: [],
  },
  methods: {
    inc() {
      this.__set('count', this.count + 1);
    },
  },
});
"
`;

exports[`T23 @State → data + 赋值改写 > 赋值改写全形态：= / += / 嵌套路径 / 下标 / ++ 1`] = `
"// Generated by ArkMP, do not edit
const { createPage } = require('@arkmp/runtime');

createPage({
  state: {
    count: 0,
    user: {"name":""},
    list: [],
  },
  methods: {
    run() {
      this.__set('count', 1);
      this.__set('count', this.count + (2));
      this.__set('user.name', 'x');
      this.__set('list[0]', 9);
      this.__set('count', this.count - 1);
    },
  },
});
"
`;

exports[`T24 @Prop / @Link → properties > @Link：properties + __set 桥接方法 + 赋值改写为桥接调用 1`] = `
"// Generated by ArkMP, do not edit
const { createComponent } = require('@arkmp/runtime');

createComponent({
  properties: {
    isOn: Boolean,
  },
  methods: {
    __set_isOn(v) {
      this.setData({ isOn: v });
      this.triggerEvent('update:ison', v);
    },
    toggle() {
      this.__set_isOn(!this.isOn);
    },
  },
});
"
`;

